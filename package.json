{
  "name": "oathstar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "build": "vite build",
    "vendor:datastar": "curl -g -fsSL https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.2/bundles/datastar.js -o public/vendor/datastar/datastar.js && echo '2837d87acf6ee0ba8e4e63765926c25a98d63883b02f88be194a86b81d3fd24a  public/vendor/datastar/datastar.js' | shasum -a 256 -c -",
    "preview": "vite preview --host 127.0.0.1",
    "server:dev": "cargo run -p oathstar-server",
    "verify": "bin/gate.sh",
    "verify:quick": "bin/gate.sh --fast",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:check": "cargo check --workspace",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node --test tests/*.test.js",
    "studio:css": "tailwindcss -i crates/oathstar-studio/static/studio.tw.css -o crates/oathstar-studio/static/studio.css --minify",
    "studio:css:check": "tailwindcss -i crates/oathstar-studio/static/studio.tw.css -o \"${TMPDIR:-/tmp}/oathstar-studio.css.check\" --minify && cmp \"${TMPDIR:-/tmp}/oathstar-studio.css.check\" crates/oathstar-studio/static/studio.css"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.1",
    "@tauri-apps/cli": "^2.11.2",
    "daisyui": "5.5.23",
    "esbuild": "^0.28.0",
    "tailwindcss": "4.3.1",
    "vite": "^8.0.16"
  }
}
